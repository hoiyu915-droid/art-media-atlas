{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoiyu915-droid.github.io/art-media-atlas/Media/schemas/media-atlas.schema.json",
  "title": "Art Media Atlas resolver manifest",
  "type": "object",
  "required": [
    "$schema",
    "atlas_id",
    "schema_version",
    "atlas_version",
    "repository",
    "source_card_count",
    "automatic_candidate_count",
    "capability_scale",
    "resolver_contract",
    "media"
  ],
  "properties": {
    "$schema": { "const": "schemas/media-atlas.schema.json" },
    "atlas_id": { "const": "art-media-atlas" },
    "schema_version": { "const": "1.0.0" },
    "atlas_version": { "type": "string", "minLength": 1 },
    "repository": { "const": "hoiyu915-droid/art-media-atlas" },
    "source_card_count": { "const": 75 },
    "automatic_candidate_count": { "type": "integer", "minimum": 1, "maximum": 75 },
    "capability_scale": { "type": "object" },
    "resolver_contract": { "type": "object" },
    "media": {
      "type": "array",
      "minItems": 75,
      "maxItems": 75,
      "items": { "$ref": "#/$defs/medium" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "medium": {
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "name_en",
        "family",
        "medium_kind",
        "assets",
        "mechanisms",
        "capabilities",
        "recommended_roles",
        "compatible_partners",
        "avoid",
        "resolver"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^M(0[1-9]|[1-6][0-9]|7[0-5])$" },
        "name_zh": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "medium_kind": {
          "enum": [
            "physical_visual_medium",
            "photographic_process",
            "digital_output_method",
            "digital_creation_method"
          ]
        },
        "assets": {
          "type": "object",
          "required": ["card", "thumbnail", "reference_panels"],
          "properties": {
            "card": { "type": "string", "pattern": "^Media/cards/" },
            "thumbnail": { "type": "string", "pattern": "^Media/thumbnails/" },
            "reference_panels": {
              "type": "array",
              "items": { "type": "string", "pattern": "^Media/panels/" }
            }
          },
          "additionalProperties": false
        },
        "mechanisms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "capabilities": {
          "type": "object",
          "required": [
            "opacity",
            "line_precision",
            "medical_label_legibility",
            "portrait_fit",
            "anatomy_fit",
            "scene_fit",
            "public_health_fit",
            "archive_fit",
            "digital_fit"
          ],
          "additionalProperties": { "$ref": "#/$defs/score" }
        },
        "recommended_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["base_medium", "line_medium", "texture_accent", "output_finish"]
          }
        },
        "compatible_partners": { "type": "array", "items": { "type": "object" } },
        "avoid": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "resolver": {
          "type": "object",
          "required": [
            "automatic_use_allowed",
            "manual_review_required",
            "assessment_basis",
            "confidence"
          ],
          "properties": {
            "automatic_use_allowed": { "type": "boolean" },
            "manual_review_required": { "type": "boolean" },
            "assessment_basis": {
              "enum": ["pilot_visual_estimate", "family_default_estimate"]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
